{
  "name": "@gpmlimeng-cyber/ds-bot-mobile",
  "version": "0.2.0",
  "description": "DS Bot Mobile: a team of long-lived Bots on DeepSeek Harness — Main Bots, Bot-to-Bot messages and group chats, with a mobile-first skin. Fork of Fei2411/DeepSeek-Bot (ds-bot).",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "bot",
    "bots",
    "agents",
    "team",
    "group-chat",
    "mobile"
  ],
  "homepage": "https://github.com/gpmlimeng-cyber/dsh-bot#readme",
  "bugs": {
    "url": "https://github.com/gpmlimeng-cyber/dsh-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpmlimeng-cyber/dsh-bot.git",
    "directory": "ds-bot"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "client.js",
    "web-search.js",
    "cordis.patch.yml",
    "scripts/check-shell-contract.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "node scripts/build-client.mjs",
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --experimental-test-isolation=none --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-web": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "author": "gpmlimeng-cyber",
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
