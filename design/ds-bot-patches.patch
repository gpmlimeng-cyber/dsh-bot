+        method: 'PUT',
+        body: {
+          page_number: page,
+          page_size: MARKET_PAGE_SIZE,
+          search: String(body.query ?? ''),
+          ...(category === '' ? {} : { filter: { category } }),
+        },
+      }))?.data ?? {}
+      const rows = Array.isArray(data.mcp_server_list) ? data.mcp_server_list : []
