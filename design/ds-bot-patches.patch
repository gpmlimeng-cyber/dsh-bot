+      continue
+    }
+    if (line.trim() === '') {
+      flushParagraph()
+      flushList()
+      continue
+    }
+    if (line.startsWith('>')) {
+      flushParagraph()
+      flushList()
+      blocks.push({ kind: 'quote', text: line.replace(/^>\s?/, '').trim() })
+      continue
+    }
