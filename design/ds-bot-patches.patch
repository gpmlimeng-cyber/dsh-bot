@@ -0,0 +1,30 @@
+// The SuperAgent page's preferences, applied the same way wherever they come from. A switch
+// is on unless it was written `false`, so deleting a key turns it back on; the one threshold
+// is refused outside its bounds rather than clamped, and `null` resets either to its default.
+import { FOLD_AT_BOUNDS, isFoldAt } from './fold-at.js'
+import { TOOL_POLICY_MODES } from './tool-policy.js'
+
+export const SWITCH_KEYS = ['saFold', 'saConclude', 'saLookup', 'saBackground', 'saPrepare']
+
+export function applySuperAgentPrefs(prefs, body) {
+  for (const key of SWITCH_KEYS) {
+    if (body[key] === true) prefs[key] = true
+    else if (body[key] === false) prefs[key] = false
+    else if (body[key] === null) delete prefs[key]
+  }
+  if (body.saToolPolicy !== undefined) {
+    const mode = body.saToolPolicy
+    if (mode === null) delete prefs.saToolPolicy
+    else if (TOOL_POLICY_MODES.includes(mode)) prefs.saToolPolicy = mode
+    else throw Object.assign(new Error(`Tool policy must be ${TOOL_POLICY_MODES.join(', ')}`), { code: 'bot/invalid' })
+  }
+  if (body.saFoldAt === undefined) return prefs
+  const at = body.saFoldAt
+  if (at === null) delete prefs.saFoldAt
+  else if (isFoldAt(at)) prefs.saFoldAt = { chars: at.chars, lines: at.lines }
+  else {
+    const message = `Fold threshold must be ${FOLD_AT_BOUNDS.chars.join('–')} characters and ${FOLD_AT_BOUNDS.lines.join('–')} lines`
+    throw Object.assign(new Error(message), { code: 'bot/invalid' })
+  }
+  return prefs
+}
diff --git a/ds-bot/src/shared/tool-policy.js b/ds-bot/src/shared/tool-policy.js
new file mode 100644
index 00000000..2930d60d
--- /dev/null
+++ b/ds-bot/src/shared/tool-policy.js
@@ -0,0 +1,35 @@
+// C tier: what a Bot may run on work that reached it from another Bot, without the user
+// having asked for it. The mode and the table live here so the host's guard and the
+// settings page cannot drift; `auto` is in the data layer only until the ask path is
+// verified, so the page offers `off` and `observe`.
+
+export const TOOL_POLICY_MODES = ['off', 'observe', 'auto']
+export const TOOL_POLICY_DEFAULT = 'observe'
+// Read-only tools an inferred turn keeps: asking the user, and showing a card. Without
+// these a refusal leaves the model no way to ask, and it retries.
+export const OPEN_TOOLS = ['ask_user', 'show_view']
+// Consecutive refusals after which asking turns into a plain denial, so a missing user
+// cannot leave the turn waiting for an answer that never comes.
+export const STALLED_AFTER = 3
+
+export const toolPolicyOf = prefs => (TOOL_POLICY_MODES.includes(prefs?.saToolPolicy) ? prefs.saToolPolicy : TOOL_POLICY_DEFAULT)
+
+// `admission` is what the delivery that started this turn was recorded as:
+// 'explicit' (the user's own request), 'inferred' (relayed by a Bot), or undefined when
+// nothing was recorded — a private chat is explicit even without a record, as B tier
+// records only what a Bot started.
+export function toolDecision({ mode, name, nested = false, admission, granted = false, refusals = 0 }) {
+  const effective = mode === 'auto' || mode === 'observe' ? mode : 'off'
+  if (effective === 'off') return { decision: 'allow', rule: 'off' }
+  if (OPEN_TOOLS.includes(name)) return { decision: 'allow', rule: 'open' }
+  // A program's own transport call carries the work its inner calls do; those are judged.
+  if (name === 'run_code' && !nested) return { decision: 'allow', rule: 'transport' }
+  if (admission === undefined) return { decision: 'allow', rule: 'unknown' }
+  if (admission === 'explicit') return { decision: 'allow', rule: 'explicit' }
+  if (granted) return { decision: 'allow', rule: 'granted' }
+  if (effective === 'observe') return { decision: 'would_deny', rule: 'relay-not-authorization' }
+  if (refusals >= STALLED_AFTER) return { decision: 'deny', rule: 'stalled' }
+  return { decision: 'ask', rule: 'relay-not-authorization' }
+}
+
+export const DENIAL = name => `Denied by policy: this work was relayed by another Bot and the user has not approved ${name}. Stop retrying it; call ask_user to ask, or wait for the user's own request.`
diff --git a/ds-bot/src/shared/turn-summary.js b/ds-bot/src/shared/turn-summary.js
new file mode 100644
index 00000000..3588b823
--- /dev/null
+++ b/ds-bot/src/shared/turn-summary.js
@@ -0,0 +1,47 @@
+// How a finished turn's tool calls read as one line: a class and a count, and files counted
+// once by path, so reading the same file three times is "3 calls, 1 file".
+const CLASSES = [
+  ['read', ['read', 'read_own_chat', 'read_group_chat', 'list_files', 'glob', 'grep', 'search', 'list_bots', 'list_bot_models', 'list_capabilities', 'list_secrets', 'recall']],
+  ['write', ['write', 'edit', 'str_replace', 'apply_patch', 'remember', 'forget']],
+  ['run', ['bash', 'pwsh', 'run_code', 'browser']],
+  ['show', ['show_view', 'ask_user', 'request_secret', 'present']],
+]
+
+export function classOf(name) {
+  for (const [kind, names] of CLASSES) if (names.includes(name)) return kind
+  return 'other'
+}
+
+// The file a call names, by path only: a read already done is not a second file.
+export function fileOf(args) {
+  if (args === null || typeof args !== 'object') return undefined
+  const path = args.path ?? args.file ?? args.file_path
+  return typeof path === 'string' && path !== '' ? path : undefined
+}
+
+// `calls` are the turn's calls in order; returns counts per class and the unique paths.
+export function summarizeCalls(calls) {
+  const counts = { read: 0, write: 0, run: 0, show: 0, other: 0 }
+  const files = new Set()
+  for (const call of calls ?? []) {
+    const name = String(call?.name ?? '')
+    if (name === '') continue
+    counts[classOf(name)] += 1
+    const file = fileOf(call.arguments ?? call.args)
+    if (file !== undefined) files.add(file)
+  }
+  return { counts, files: [...files] }
+}
+
+// The one-line label, in the order the reader cares about: what was read or changed, then
+// what was run or shown. Empty when nothing happened.
+export function summaryLine({ counts, files }, t = (text, params) => text.replace(/\{(\w+)\}/g, (_, key) => String(params?.[key] ?? ''))) {
+  const parts = []
+  if (counts.read > 0) parts.push(t('{count} read', { count: counts.read }))
+  if (counts.write > 0) parts.push(t('{count} changed', { count: counts.write }))
+  if (counts.run > 0) parts.push(t('{count} run', { count: counts.run }))
+  if (counts.show > 0) parts.push(t('{count} shown', { count: counts.show }))
+  if (counts.other > 0) parts.push(t('{count} other', { count: counts.other }))
+  if (files.length > 0) parts.push(t('{count} files', { count: files.length }))
+  return parts.join(' · ')
+}
