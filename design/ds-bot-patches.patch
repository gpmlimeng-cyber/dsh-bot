+// The two faces the Font setting offers beside the system one. Both are variable fonts
+// with the full weight axis, both under the SIL Open Font License 1.1, and both are stored
+// as data URLs so the plugin renders the same on a machine with no network or install.
+//   Inter 4.1 — https://github.com/rsms/inter — @fontsource-variable/inter (latin)
+//   Geist   1.5 — https://github.com/vercel/geist-font — @fontsource-variable/geist (latin)
+// CJK text falls back to the system face, as the shell does.
+
+const INTER = 'data:font/woff2;base64,'
+const GEIST = 'data:font/woff2;base64,'
+
+export const FONT_FACES = `@font-face{font-family:"Inter Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${INTER}) format("woff2")}
+@font-face{font-family:"Geist Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${GEIST}) format("woff2")}`
