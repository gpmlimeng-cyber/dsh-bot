+        items.push({
+          id: `${seq}`, kind: 'bot', botId: source.senderSessionId ?? null, name: source.senderName ?? null,
+          text: textOf(content).replace(POST_HEADER, ''), time: event.time ?? null,
+          ...(file ? { whole: { length: source.length, file } } : {}),
