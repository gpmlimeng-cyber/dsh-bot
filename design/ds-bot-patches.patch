+ *
+ * @param {object} props - `size` from the sidebar.
+ * @returns {object} Element.
+ */
+function PanelIcon({ size }) {
+  return h(Icon, { name: 'i-skill', size: size ?? 18 })
+}
+
+// The panel wants its stylesheet and its Host-backed state once per page, not once per mount.
+let mounted = false
+export function readySkillMarket() {
+  if (mounted) return
+  mounted = true
+  insertStylesheet(CSS)
+  void panelStateReady()
+}
+
+export { SkillMarketPanel }
