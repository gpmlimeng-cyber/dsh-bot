+      if (code === null) {
+        flushParagraph()
+        flushList()
+        code = []
+      } else {
+        blocks.push({ kind: 'code', lines: code })
+        code = null
+      }
+      continue
+    }
+    if (code !== null) {
+      code.push(line)
+      continue
+    }
