+    const x = a[index]
+    const y = b[index]
+    if (x === y) continue
+    if (x === undefined) return -1
+    if (y === undefined) return 1
+    const nx = /^\d+$/.test(x) ? Number(x) : Number.NaN
+    const ny = /^\d+$/.test(y) ? Number(y) : Number.NaN
