@@ -0,0 +1,52 @@
+// Minimal coverage for the local features that carry no test of their own. Each case pins
+// behaviour or wiring, not pixels: colour, sizes and spacing stay the reviewer's business.
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { GAZE } from '../src/client/gaze.js'
+import { dismissDrawerIfOpen, holdDrawerDismiss } from '../src/client/drawer-dismiss.js'
+
+const source = name => readFileSync(new URL(`../src/client/${name}`, import.meta.url), 'utf8')
+
+const PNG_MAGIC = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
+
+test('the Gaze picker ships four usable faces', () => {
+  assert.equal(GAZE.length, 4)
+  assert.equal(new Set(GAZE.map(face => face.id)).size, 4, 'two faces share an id')
+  for (const face of GAZE) {
+    const image = face.image
+    assert.ok(typeof face.id === 'string' && face.id !== '', 'a face has no id')
+    assert.match(image, /^data:image\/png;base64,[A-Za-z0-9+/]+={0,2}$/, `${face.id}: not an inline PNG`)
+    const png = Buffer.from(image.slice('data:image/png;base64,'.length), 'base64')
+    assert.deepEqual(png.subarray(0, PNG_MAGIC.length), PNG_MAGIC, `${face.id}: not a PNG`)
+  }
+})
+
+test('drawer entries close the drawer, everything else leaves it alone', () => {
+  const collapsed = []
+  const release = holdDrawerDismiss(() => collapsed.push('collapsed'))
+  try {
+    // Only a caller that says it came from the drawer may collapse it: the shell reports no
+    // open flag, so guessing would toggle a closed drawer open.
+    dismissDrawerIfOpen(false)
+    dismissDrawerIfOpen(undefined)
+    assert.deepEqual(collapsed, [])
+    dismissDrawerIfOpen(true)
+    assert.deepEqual(collapsed, ['collapsed'])
+  } finally {
+    release()
+  }
+  // A missing holder is a no-op rather than a wrong toggle.
+  dismissDrawerIfOpen(true)
+  assert.deepEqual(collapsed, ['collapsed'])
+})
+
+test('the phone sheet is covered by a catcher that closes it', () => {
+  const css = source('styles.js')
+  // The desktop keeps the pane as it was, so both the sheet and its catcher exist only
+  // under the phone frame.
+  assert.match(css, /\.bt-sheet-catcher,\.bt-sheet-grip\{display:none\}/)
+  assert.match(css, /html:has\(\[data-mobile-nav="frame"\]\) \.bt-sheet-catcher\{[^}]*display:block/)
+  const catchers = source('new-chat.js').match(/className: 'bt-sheet-catcher', onClick: close/g) ?? []
+  assert.equal(catchers.length, 2, 'each new-chat sheet renders one catcher that closes it')
+})
diff --git a/ds-bot/test/patch-i18n.test.js b/ds-bot/test/patch-i18n.test.js
new file mode 100644
index 00000000..d68432f2
--- /dev/null
+++ b/ds-bot/test/patch-i18n.test.js
@@ -0,0 +1,46 @@
+// The dictionary is keyed by the English copy itself, so a mistake is silent: a duplicated
+// key shadows the first entry, and copy the host renders that the table never learned comes
+// out in English. i18n.test.js covers the client → table direction; this covers the other
+// side (the host) and the duplicate.
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { readdirSync, readFileSync } from 'node:fs'
+import { DICTIONARY } from '../src/client/i18n.js'
+
+const SOURCE = new URL('../src/client/i18n.js', import.meta.url)
+// The host renders its own copy through the same table, so its literals count too.
+const DIRS = ['../src/client/', '../src/host/']
+
+const referenced = () => {
+  const keys = new Set()
+  for (const dir of DIRS) {
+    for (const name of readdirSync(new URL(dir, import.meta.url)).filter(file => file.endsWith('.js'))) {
+      const text = readFileSync(new URL(name, new URL(dir, import.meta.url)), 'utf8')
+      for (const match of text.matchAll(/\b(?:t|hostText)\(\s*(['"])((?:\\.|(?!\1).)*)\1/g)) {
+        keys.add(match[2].replace(/\\'/g, "'"))
+      }
+    }
+  }
+  return keys
+}
+
+test('no English copy is keyed twice', () => {
+  const text = readFileSync(SOURCE, 'utf8')
+  const start = text.indexOf('const ZH = {')
+  const end = text.indexOf('\n}\n', start)
+  assert.notEqual(start, -1, 'the Chinese table is gone')
+  assert.notEqual(end, -1, 'the Chinese table has no end')
+  const seen = new Map()
+  const duplicates = []
+  for (const match of text.slice(start, end).matchAll(/^\s{2}(?:'((?:[^'\\]|\\.)*)'|"((?:[^"\\]|\\.)*)"|([A-Za-z_$][\w$]*))\s*:/gm)) {
+    const key = match[1] ?? match[2] ?? match[3]
+    if (seen.has(key)) duplicates.push(key)
+    seen.set(key, true)
+  }
+  assert.deepEqual(duplicates, [], 'a duplicated key keeps only the last translation')
+})
+
+test('every literal the client or the host translates has a Chinese entry', () => {
+  const missing = [...referenced()].filter(key => !Object.hasOwn(DICTIONARY.zh, key)).sort()
+  assert.deepEqual(missing, [])
+})
diff --git a/ds-bot/test/patch-ledger.test.js b/ds-bot/test/patch-ledger.test.js
new file mode 100644
index 00000000..1e4ef297
--- /dev/null
+++ b/ds-bot/test/patch-ledger.test.js
@@ -0,0 +1,76 @@
+// The patch is the replayable record of every local change. These tests keep it replayable
+// without restating any of its numbers by hand: the statistics below are recounted from the
+// patch, and the ledger's own table is only allowed to be the generator's output.
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { execFileSync, spawnSync } from 'node:child_process'
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const PLUGIN = dirname(dirname(fileURLToPath(import.meta.url)))
+const ROOT = dirname(PLUGIN)
+const PATCH = join(ROOT, 'design/ds-bot-patches.patch')
+const HUNKS = join(ROOT, 'design/ds-bot-patches.hunks.md')
+// The ledger's baseline: the upstream release the local commits sit on top of. Read
+// from the ledger so a version bump does not leave this test asserting an old ref.
+const BASE = /基线：\*\*本仓标签 `([^`]+)`\*\*/.exec(readFileSync(join(ROOT, 'design/ds-bot-patches.md'), 'utf8'))?.[1] ?? 'v0.2.5'
+// client.js is generated from src/client, and gaze.js carries generated images, so neither
+// is part of the hand-maintained patch.
+const PATCHED = ['ds-bot', ':!ds-bot/client.js', ':!ds-bot/src/client/gaze.js']
+
+const git = (args, cwd) => spawnSync('git', args, { cwd, encoding: 'utf8' })
+
+test('the patch still reverses cleanly on HEAD', () => {
+  // HEAD already contains every hunk, so the forward direction cannot apply here; the
+  // direction that proves the patch still describes HEAD is the reverse one.
+  const result = git(['apply', '--reverse', '--check', PATCH], ROOT)
+  assert.equal(result.status, 0, result.stderr)
+})
+
+test('the patch still replays on the baseline, and is exactly the baseline diff', () => {
+  const base = git(['rev-parse', '--verify', '--quiet', `${BASE}^{commit}`], ROOT)
+  assert.equal(base.status, 0, `the ledger baseline ${BASE} is not a ref here: ${base.stderr}`)
+
+  // A work tree of the baseline is the only place the forward direction can run.
+  const dir = mkdtempSync(join(tmpdir(), 'ds-bot-baseline-'))
+  try {
+    const added = git(['worktree', 'add', '--detach', '--quiet', dir, BASE], ROOT)
+    assert.equal(added.status, 0, added.stderr)
+    const applied = git(['apply', '--check', PATCH], dir)
+    assert.equal(applied.status, 0, applied.stderr)
+  } finally {
+    git(['worktree', 'remove', '--force', dir], ROOT)
+    rmSync(dir, { recursive: true, force: true })
+  }
+
+  const diff = execFileSync('git', ['diff', BASE, 'HEAD', '--', ...PATCHED], { cwd: ROOT, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 })
+  assert.equal(readFileSync(PATCH, 'utf8'), diff, `regenerate it: git diff ${BASE} HEAD -- ${PATCHED.join(' ')} > design/ds-bot-patches.patch`)
+})
+
+test('the ledger table is the generator output', () => {
+  const generated = spawnSync(process.execPath, [join(ROOT, 'tools/patch-ledger.mjs')], { encoding: 'utf8', maxBuffer: 8 * 1024 * 1024 })
+  assert.equal(generated.status, 0, generated.stderr)
+  assert.equal(readFileSync(HUNKS, 'utf8'), generated.stdout, 'regenerate it: node tools/patch-ledger.mjs > design/ds-bot-patches.hunks.md')
+})
+
+test('the statistics in the ledger table are counted from the patch', () => {
+  let files = 0, hunks = 0, added = 0, removed = 0
+  for (const line of readFileSync(PATCH, 'utf8').split('\n')) {
+    if (line.startsWith('+++ b/')) files++
+    else if (line.startsWith('--- ')) continue
+    else if (line.startsWith('@@')) hunks++
+    else if (line.startsWith('+')) added++
+    else if (line.startsWith('-')) removed++
+  }
+
+  const stats = readFileSync(HUNKS, 'utf8')
+  const count = label => {
+    const found = new RegExp(`^\\| ${label} \\| (\\d+) \\|$`, 'm').exec(stats)
+    assert.notEqual(found, null, `the generated statistics have no ${label} row`)
+    return Number(found[1])
+  }
+  assert.deepEqual({ files: count('文件'), hunks: count('hunks'), added: count('新增行'), removed: count('删除行') },
+    { files, hunks, added, removed })
+})
